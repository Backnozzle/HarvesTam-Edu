---
// Revisar fuentes
// Para la info, sigue key:value como un diccionario de datos
const ficha = [
  { k: "Nombre científico", v: "Prosopis tamarugo", cursiva: true },
  { k: "Distribución", v: "Arica y Parinacota, Tarapacá y Antofagasta" },
  { k: "Clima", v: "Árido, con terrenos secos y muy poca humedad" },
  { k: "Situación", v: "En peligro de extinción por actividad humana" },
];

// Para amenazas
const amenazas = [
  {
    t: "Abatimiento del acuífero subterráneo",
    d: "Al ser una especie freatófita obligada, depende de napas accesibles. La sobreextracción hídrica para faenas mineras y sanitarias deprime el acuífero más allá de su umbral crítico (15–20 m), provocando estrés hídrico severo, desecación de copa y aborto de la carga frutal."
  },
  {
    t: "Degradación histórica por el ciclo salitrero",
    d: "Durante los siglos XIX y principios del XX, millones de hectáreas de bosque primario fueron taladas indiscriminadamente para abastecer de leña y carbón a las calderas de las oficinas salitreras y fundiciones, dejando relictos fragmentados que aún no recuperan su densidad original."
  },
  {
    t: "Colapso de la regeneración y presión antrópica",
    d: "La germinación natural depende de eventos aluviales andinos excepcionales que ocurren cada 30 a 40 años. La compactación del suelo por tránsito no regulado, la ocupación de terrenos y el sobrepastoreo destruyen el escaso banco de semillas e impiden el establecimiento de plántulas."
  },
];

const foto = "/Pampa-tamarugal.webp";
---

<section id="especie" class="w-full bg-arbol text-desierto px-6 sm:px-12 md:px-16 py-16 sm:py-24">
  <div class="max-w-7xl mx-auto">
    
    <!-- Frase o cita -->
    <p class="font-serif italic text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-tight max-w-3xl mb-16 sm:mb-24 text-desierto/95">
      "Para cuidar una especie, primero hay que medirla."
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      
      <!-- Foto y descripcion -->
      <div class="space-y-6">
        <h2 class="font-serif text-2xl sm:text-3xl font-medium tracking-tight">
          La especie y su entorno
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-desierto/80">
          El <em class="italic font-serif">Prosopis tamarugo</em> es un árbol endémico del norte de Chile capaz de subsistir en condiciones extremas de salinidad y aridez. Su rol es vital para la biodiversidad de la Pampa del Tamarugal, funcionando como refugio biológico y recurso alimenticio indispensable.
        </p>
        
        {foto && (
        <div class="mt-6 overflow-hidden rounded-sm border border-desierto/20 shadow-lg">
          <img 
            src={foto} 
            alt="Prosopis tamarugo en su hábitat natural" 
            width="800"
            height="450"
            class="w-full h-auto aspect-video object-cover hover:scale-105 transition-transform duration-500"
            loading="lazy" 
            decoding="async"
          />
        </div>
        )}
      </div>

      <!-- Ficha Botánica -->
      <dl class="w-full divide-y divide-desierto/20 border-y border-desierto/20">
        {ficha.map((f) => (
          <div class="py-4 sm:py-5 flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1">
            <dt class="text-xs sm:text-sm uppercase tracking-wider text-desierto/60">
              {f.k}
            </dt>
            <dd class={`text-base sm:text-lg text-desierto ${f.cursiva ? 'font-serif italic text-xl sm:text-2xl' : 'font-normal'}`}>
              {f.v}
            </dd>
          </div>
        ))}
      </dl>

    </div>

    <!-- Factores de amenaza -->
    <div class="mt-24 sm:mt-32">
      <h2 class="font-serif text-2xl sm:text-3xl font-medium tracking-tight mb-8 sm:mb-12">
        Factores críticos de amenaza
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10">
        {amenazas.map((a) => (
          <article class="pt-6 border-t border-desierto/25 space-y-2">
            <h3 class="font-serif text-lg sm:text-xl font-medium text-desierto">
              {a.t}
            </h3>
            <p class="text-xs sm:text-sm text-desierto/75 leading-relaxed">
              {a.d}
            </p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>