<div id="skeleton-loader" class="w-full max-w-6xl mx-auto px-4 py-8 space-y-8 animate-pulse">
  <!-- Cabecera Skeleton -->
  <div class="space-y-3 border-b border-arbol/10 pb-6">
    <div class="h-7 w-48 bg-arbol/10 rounded-sm"></div>
    <div class="h-4 w-72 bg-arbol/5 rounded-sm"></div>
  </div>

  <!-- Bloque superior de tarjetas -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="h-32 bg-white rounded-sm border border-arbol/10 p-5 space-y-3 shadow-sm">
      <div class="h-3.5 w-24 bg-arbol/10 rounded-sm"></div>
      <div class="h-8 w-16 bg-arbol/15 rounded-sm"></div>
      <div class="h-3 w-32 bg-arbol/5 rounded-sm"></div>
    </div>
    <div class="h-32 bg-white rounded-sm border border-arbol/10 p-5 space-y-3 shadow-sm">
      <div class="h-3.5 w-28 bg-arbol/10 rounded-sm"></div>
      <div class="h-8 w-20 bg-arbol/15 rounded-sm"></div>
      <div class="h-3 w-36 bg-arbol/5 rounded-sm"></div>
    </div>
    <div class="h-32 bg-white rounded-sm border border-arbol/10 p-5 space-y-3 shadow-sm">
      <div class="h-3.5 w-32 bg-arbol/10 rounded-sm"></div>
      <div class="h-8 w-14 bg-arbol/15 rounded-sm"></div>
      <div class="h-3 w-28 bg-arbol/5 rounded-sm"></div>
    </div>
  </div>

  <!-- Área principal de trabajo -->
  <div class="bg-white border border-arbol/10 rounded-sm p-6 space-y-4 shadow-sm">
    <div class="h-5 w-40 bg-arbol/10 rounded-sm"></div>
    <div class="space-y-3 pt-2">
      <div class="h-10 bg-arbol/5 rounded-sm w-full"></div>
      <div class="h-10 bg-arbol/5 rounded-sm w-full"></div>
      <div class="h-10 bg-arbol/5 rounded-sm w-full"></div>
    </div>
  </div>
</div>