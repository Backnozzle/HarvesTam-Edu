---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 · No encontrado">
  <section class="min-h-[70vh] flex items-center justify-center px-6 sm:px-12 md:px-16 py-16">
    <div class="max-w-xl mx-auto text-center space-y-6">
      
      <span class="inline-block font-mono text-sm tracking-widest uppercase opacity-60 text-arbol">
        Error 404 · No se encontró lo que buscabas, sin embargo, disfruta de los pequeños desvíos porque de ese modo encontrarás aquello que es más importante que lo que estabas buscando.
      </span>

      <h1 class="font-serif italic text-5xl sm:text-6xl md:text-7xl font-normal leading-tight text-arbol">
        Terreno no explorado
      </h1>


      <!-- Redirigir -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 bg-arbol text-desierto font-medium text-sm sm:text-base rounded-sm shadow-sm hover:bg-arbolHover hover:-translate-y-0.5 transition-all duration-200"
        >
          Volver al inicio
        </a>

        <a
          href="/estimar"
          class="inline-flex items-center justify-center px-5 py-3 text-arbol font-medium text-sm sm:text-base border-b border-arbol hover:opacity-75 transition-opacity"
        >
          Ir al estimador
        </a>
      </div>

    </div>
  </section>
</Layout>
