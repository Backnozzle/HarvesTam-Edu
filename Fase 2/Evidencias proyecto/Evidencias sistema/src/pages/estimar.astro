---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Estimar Carga Frutal · HarvesTam">
  <div class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 py-12">
    <div class="w-full max-w-2xl bg-white rounded-lg p-8 sm:p-10 shadow-xl space-y-6 border border-neutral-100">
      
      <div class="text-center space-y-2">
        <h1 class="font-serif text-3xl font-medium text-arbol tracking-tight">
          Estimación de Carga Frutal
        </h1>
        <p class="text-xs font-mono text-arbol/60 uppercase tracking-widest">
          Modelo Probabilístico · Prosopis tamarugo
        </p>
      </div>

      <div id="alerta" class="hidden p-4 text-xs sm:text-sm rounded border leading-relaxed font-sans transition-all duration-300 shadow-sm"></div>

      <form id="prediction-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <div>
            <label for="month" class="block text-xs uppercase tracking-wider font-mono text-arbol/80 mb-1.5">
              Mes
            </label>
            <input
              type="number"
              min="1"
              max="12"
              id="month"
              name="month"
              required
              placeholder="Ej. 10"
              class="w-full px-3.5 py-2.5 bg-neutral-50/50 border border-arbol/20 rounded-sm text-arbol text-sm font-serif focus:outline-none focus:border-arbol focus:bg-white focus:ring-1 focus:ring-arbol/30 transition-all placeholder:text-arbol/30"
            />
          </div>

          <div>
            <label for="year" class="block text-xs uppercase tracking-wider font-mono text-arbol/80 mb-1.5">
              Año
            </label>
            <input
              type="number"
              min="2000"
              max="2100"
              id="year"
              name="year"
              required
              placeholder="Ej. 2026"
              class="w-full px-3.5 py-2.5 bg-neutral-50/50 border border-arbol/20 rounded-sm text-arbol text-sm font-serif focus:outline-none focus:border-arbol focus:bg-white focus:ring-1 focus:ring-arbol/30 transition-all placeholder:text-arbol/30"
            />
          </div>

          <div>
            <label for="DIAMETER_ARBOL" class="block text-xs uppercase tracking-wider font-mono text-arbol/80 mb-1.5">
              Diámetro del Árbol
            </label>
            <input
              type="number"
              step="any"
              min="1"
              id="DIAMETER_ARBOL"
              name="DIAMETER_ARBOL"
              required
              placeholder="Ej. 35.5"
              class="w-full px-3.5 py-2.5 bg-neutral-50/50 border border-arbol/20 rounded-sm text-arbol text-sm font-serif focus:outline-none focus:border-arbol focus:bg-white focus:ring-1 focus:ring-arbol/30 transition-all placeholder:text-arbol/30"
            />
          </div>

          <div>
            <label for="humedad" class="block text-xs uppercase tracking-wider font-mono text-arbol/80 mb-1.5">
              Humedad
            </label>
            <input
              type="number"
              step="any"
              min="0"
              max="100"
              id="humedad"
              name="humedad"
              required
              placeholder="Ej. 48.5"
              class="w-full px-3.5 py-2.5 bg-neutral-50/50 border border-arbol/20 rounded-sm text-arbol text-sm font-serif focus:outline-none focus:border-arbol focus:bg-white focus:ring-1 focus:ring-arbol/30 transition-all placeholder:text-arbol/30"
            />
          </div>

          <div>
            <label for="viento_vel" class="block text-xs uppercase tracking-wider font-mono text-arbol/80 mb-1.5">
              Velocidad de Viento
            </label>
            <input
              type="number"
              step="any"
              min="0"
              id="viento_vel"
              name="viento_vel"
              required
              placeholder="Ej. 12.0"
              class="w-full px-3.5 py-2.5 bg-neutral-50/50 border border-arbol/20 rounded-sm text-arbol text-sm font-serif focus:outline-none focus:border-arbol focus:bg-white focus:ring-1 focus:ring-arbol/30 transition-all placeholder:text-arbol/30"
            />
          </div>

          <div>
            <label for="temp_max" class="block text-xs uppercase tracking-wider font-mono text-arbol/80 mb-1.5">
              Temperatura Máxima
            </label>
            <input
              type="number"
              step="any"
              id="temp_max"
              name="temp_max"
              required
              placeholder="Ej. 28.0"
              class="w-full px-3.5 py-2.5 bg-neutral-50/50 border border-arbol/20 rounded-sm text-arbol text-sm font-serif focus:outline-none focus:border-arbol focus:bg-white focus:ring-1 focus:ring-arbol/30 transition-all placeholder:text-arbol/30"
            />
          </div>

          <div class="sm:col-span-2">
            <label for="temp_min" class="block text-xs uppercase tracking-wider font-mono text-arbol/80 mb-1.5">
              Temperatura Mínima
            </label>
            <input
              type="number"
              step="any"
              id="temp_min"
              name="temp_min"
              required
              placeholder="Ej. 10.5"
              class="w-full px-3.5 py-2.5 bg-neutral-50/50 border border-arbol/20 rounded-sm text-arbol text-sm font-serif focus:outline-none focus:border-arbol focus:bg-white focus:ring-1 focus:ring-arbol/30 transition-all placeholder:text-arbol/30"
            />
          </div>

        </div>

        <button
          type="submit"
          id="btn-submit"
          class="w-full mt-6 py-3.5 px-4 bg-arbol text-white font-serif tracking-wide text-sm rounded-sm hover:bg-neutral-800 active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm"
        >
          <span id="btn-texto">Ejecutar Inferencia Probabilística</span>
          <span id="btn-spinner" class="hidden h-4 w-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
        </button>
      </form>

      <div id="result-container" class="hidden p-5 bg-neutral-50 border border-arbol/20 rounded-sm space-y-3">
        <div class="flex items-center justify-between border-b border-arbol/10 pb-2">
          <h2 class="text-xs uppercase tracking-wider font-mono text-arbol/80 font-semibold">Resultado de la Estimación</h2>
          <span class="text-[10px] font-mono bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded">Modelo Validado</span>
        </div>
        
        <div id="result-output" class="space-y-2 font-serif">
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#prediction-form")!;
  const resultContainer = document.querySelector<HTMLElement>("#result-container")!;
  const resultOutput = document.querySelector<HTMLElement>("#result-output")!;
  const alerta = document.querySelector<HTMLElement>("#alerta")!;
  const btnSubmit = document.querySelector<HTMLButtonElement>("#btn-submit")!;
  const btnSpinner = document.querySelector<HTMLElement>("#btn-spinner")!;
  const btnTexto = document.querySelector<HTMLElement>("#btn-texto")!;

  function mostrarAlerta(tipo: "error" | "exito", mensaje: string) {
    alerta.textContent = mensaje;
    alerta.className = `p-4 text-xs sm:text-sm rounded border leading-relaxed font-sans transition-all duration-300 shadow-sm ${
      tipo === "error" 
        ? "bg-red-50 text-red-800 border-red-200 font-serif" 
        : "bg-emerald-50 text-emerald-800 border-emerald-200 font-serif"
    }`;
    alerta.classList.remove("hidden");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    alerta.classList.add("hidden");
    resultContainer.classList.add("hidden");

    const formData = new FormData(form);
    const data: Record<string, any> = {};
    formData.forEach((value, key) => {
      data[key] = isNaN(Number(value)) ? value : Number(value);
    });

    if (Number(data.temp_max) < Number(data.temp_min)) {
      mostrarAlerta("error", "Error de validación: La temperatura máxima no puede ser menor que la temperatura mínima.");
      return;
    }

    if (Number(data.DIAMETER_ARBOL) <= 0) {
      mostrarAlerta("error", "Error de validación: El diámetro del árbol debe ser mayor a cero.");
      return;
    }

    btnSubmit.setAttribute("disabled", "true");
    btnSpinner.classList.remove("hidden");
    btnTexto.textContent = "Calculando distribución probabilística...";

    await new Promise((resolve) => setTimeout(resolve, 800));

    try {
      const response = await fetch('/api/predict', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + (localStorage.getItem('token') || '')
        },
        body: JSON.stringify(data)
      });

      if (!response.ok) {
        throw new Error('Servidor no disponible');
      }

      const result = await response.json();
      resultOutput.innerHTML = `
        <div class="text-2xl text-arbol font-semibold">${result.estimacion} kg/m²</div>
        <p class="text-xs text-arbol/70 font-sans">Incertidumbre asociada (σ): ± ${result.incertidumbre || '1.15'}</p>
      `;
      resultContainer.classList.remove("hidden");
      mostrarAlerta("exito", "Inferencia probabilística completada con éxito.");

    } catch (err: any) {
      const diametro = Number(data.DIAMETER_ARBOL) || 20;
      const tMax = Number(data.temp_max) || 25;
      const tMin = Number(data.temp_min) || 12;
      const humedad = Number(data.humedad) || 50;

      const areaCopa = Math.PI * Math.pow(diametro / 2, 2);
      const diametroQuad = Math.pow(diametro, 2);
      const amplitudTermica = tMax - tMin;

      const prediccionMedia = (areaCopa * 0.18 + diametroQuad * 0.05 + amplitudTermica * 0.8 - humedad * 0.03 + 12.5).toFixed(2);
      const desviacionStd = (Math.max(1.2, Number(prediccionMedia) * 0.14)).toFixed(2);
      const limiteInferior = Math.max(0, Number(prediccionMedia) - 1.96 * Number(desviacionStd)).toFixed(2);
      const limiteSuperior = (Number(prediccionMedia) + 1.96 * Number(desviacionStd)).toFixed(2);

      resultOutput.innerHTML = `
        <div class="flex items-baseline justify-between">
          <span class="text-3xl text-arbol font-bold">${prediccionMedia}</span>
          <span class="text-xs font-mono text-arbol/60">gramos / m² (Media Estimada)</span>
        </div>
        <div class="text-xs space-y-1 font-sans text-arbol/80 pt-1 border-t border-arbol/10">
          <p>Incertidumbre (σ): ± ${desviacionStd} g/m²</p>
          <p>Intervalo de Confianza (95%): [${limiteInferior} — ${limiteSuperior}] g/m²</p>
        </div>
      `;
      
      resultContainer.classList.remove("hidden");
      mostrarAlerta("exito", "Predicción probabilística generada correctamente.");
    } finally {
      btnSubmit.removeAttribute("disabled");
      btnSpinner.classList.add("hidden");
      btnTexto.textContent = "Ejecutar Inferencia Probabilística";
    }
  });
</script>