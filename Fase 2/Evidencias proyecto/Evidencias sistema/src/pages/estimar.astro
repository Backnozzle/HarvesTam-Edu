---
import Layout from "../layouts/Layout.astro";

const inputClase =
  "w-full px-3.5 py-2.5 bg-neutral-50/50 border border-arbol/20 rounded-sm text-arbol text-sm font-serif focus:outline-none focus:border-arbol focus:bg-white focus:ring-1 focus:ring-arbol/30 transition-all placeholder:text-arbol/30";
const etiquetaClase = "block text-xs uppercase tracking-wider font-mono text-arbol/80 mb-1.5";
---

<Layout title="Estimar Carga Frutal · HarvesTam">
  <div id="contenido" class="hidden min-h-[75vh] flex items-center justify-center px-4 sm:px-6 py-12">
    <div class="w-full max-w-2xl bg-white rounded-lg p-8 sm:p-10 shadow-xl space-y-6 border border-neutral-100">
      <div class="text-center space-y-2">
        <h1 class="font-serif text-3xl font-medium text-arbol tracking-tight">Estimación de Carga Frutal</h1>
        <p class="text-xs font-mono text-arbol/60 uppercase tracking-widest">Rangos de referencia · Prosopis tamarugo</p>
      </div>

      <div id="alerta" role="alert" class="hidden p-4 text-xs sm:text-sm rounded border leading-relaxed font-serif transition-all duration-300 shadow-sm bg-red-50 text-red-800 border-red-200"></div>

      <form id="prediction-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="mes" class={etiquetaClase}>Mes</label>
            <select id="mes" name="mes" required class={inputClase}>
              <option value="" disabled selected>Seleccione</option>
              <option value="2">Febrero</option>
              <option value="12">Diciembre</option>
            </select>
          </div>
          <div>
            <label for="diametro" class={etiquetaClase}>Diámetro de copa (m)</label>
            <input type="number" step="0.01" min="0" inputmode="decimal" id="diametro" name="diametro" required placeholder="Ej. 1.10" class={inputClase} />
          </div>
        </div>
        <p class="text-xs font-sans text-arbol/60">
          El diámetro se mide en metros, a 1,20 m de altura. El modelo solo tiene datos de febrero y diciembre.
        </p>

        <button type="submit" id="btn-submit" class="w-full mt-2 py-3.5 px-4 bg-arbol text-white font-serif tracking-wide text-sm rounded-sm hover:bg-neutral-800 active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm disabled:opacity-60 disabled:cursor-not-allowed">
          <span id="btn-texto">Estimar</span>
          <span id="btn-spinner" class="hidden h-4 w-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
        </button>
      </form>

      <div id="result-container" class="hidden p-5 bg-neutral-50 border border-arbol/20 rounded-sm space-y-4">
        <div class="flex items-center justify-between border-b border-arbol/10 pb-2">
          <h2 class="text-xs uppercase tracking-wider font-mono text-arbol/80 font-semibold">Resultado de la Estimación</h2>
          <span class="text-[10px] font-mono bg-neutral-200 text-arbol px-2 py-0.5 rounded">Referencia estadística</span>
        </div>

        <div class="space-y-3 font-serif">
          <div>
            <p class="text-xs font-sans text-arbol/70">Valor central de referencia (mediana esperada)</p>
            <p class="text-3xl text-arbol font-semibold"><span data-campo="mediana"></span> g/m²</p>
          </div>
          <div class="text-sm text-arbol/90 font-sans space-y-1">
            <p>Rango probable (8 de cada 10 casos): <span data-campo="q10"></span> a <span data-campo="q90"></span> g/m²</p>
            <p>Máximo esperable (percentil 90): <span data-campo="q90"></span> g/m²</p>
          </div>

          <div id="bloque-utilidad" class="hidden pt-2 border-t border-arbol/10 flex flex-wrap items-center justify-between gap-2 font-sans">
            <span class="text-xs text-arbol/80">¿Te resultó útil esta referencia?</span>
            <div id="botones-utilidad" class="inline-flex items-center gap-2">
              <button type="button" id="btn-util-si" class="px-3 py-1 text-xs font-mono border border-arbol/25 rounded hover:bg-arbol hover:text-white transition-colors cursor-pointer">Sí</button>
              <button type="button" id="btn-util-no" class="px-3 py-1 text-xs font-mono border border-arbol/25 rounded hover:bg-neutral-200 transition-colors cursor-pointer">No</button>
            </div>
            <span id="msg-utilidad" class="hidden text-xs font-mono text-emerald-800">Gracias por tu valoración</span>
          </div>

          <p class="text-xs font-sans text-arbol/60 border-t border-arbol/10 pt-2">
            Es una referencia estadística y no un pronóstico de cosecha: la producción de árboles del mismo tamaño varía mucho.
            Versión del modelo: <span data-campo="version_modelo"></span>.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
import { registrarEstimacion, valorarEstimacion } from "../lib/estimaciones";
import { protegerRuta } from "../lib/guard";
import { supabase } from "../lib/supabase";

  protegerRuta().then((estado) => {
    if (estado.permitido) {
      document.getElementById("contenido")?.classList.remove("hidden");
    }
  });

  const form = document.querySelector<HTMLFormElement>("#prediction-form")!;
  const resultContainer = document.querySelector<HTMLElement>("#result-container")!;
  const alerta = document.querySelector<HTMLElement>("#alerta")!;
  const btnSubmit = document.querySelector<HTMLButtonElement>("#btn-submit")!;
  const btnSpinner = document.querySelector<HTMLElement>("#btn-spinner")!;
  const btnTexto = document.querySelector<HTMLElement>("#btn-texto")!;

  const bloqueUtilidad = document.querySelector<HTMLElement>("#bloque-utilidad")!;
  const botonesUtilidad = document.querySelector<HTMLElement>("#botones-utilidad")!;
  const msgUtilidad = document.querySelector<HTMLElement>("#msg-utilidad")!;
  const btnUtilSi = document.querySelector<HTMLButtonElement>("#btn-util-si")!;
  const btnUtilNo = document.querySelector<HTMLButtonElement>("#btn-util-no")!;

  let ultimaEstimacionId: string | null = null;

  function mostrarAlerta(mensaje: string) {
    alerta.textContent = mensaje;
    alerta.classList.remove("hidden");
  }

  function rellenar(campo: string, valor: string) {
    document
      .querySelectorAll<HTMLElement>(`[data-campo="${campo}"]`)
      .forEach((el) => (el.textContent = valor));
  }

  function cargando(si: boolean) {
    btnSubmit.disabled = si;
    btnSpinner.classList.toggle("hidden", !si);
    btnTexto.textContent = si ? "Calculando..." : "Estimar";
  }

  const esNumero = (v: unknown) => typeof v === "number" && Number.isFinite(v);

  async function enviarValoracion(util: boolean) {
    if (!ultimaEstimacionId) return;
    btnUtilSi.disabled = true;
    btnUtilNo.disabled = true;
    const ok = await valorarEstimacion(ultimaEstimacionId, util);
    if (ok) {
      botonesUtilidad.classList.add("hidden");
      msgUtilidad.classList.remove("hidden");
    } else {
      btnUtilSi.disabled = false;
      btnUtilNo.disabled = false;
    }
  }

  btnUtilSi.addEventListener("click", () => enviarValoracion(true));
  btnUtilNo.addEventListener("click", () => enviarValoracion(false));

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    alerta.classList.add("hidden");
    resultContainer.classList.add("hidden");
    bloqueUtilidad.classList.add("hidden");
    botonesUtilidad.classList.remove("hidden");
    msgUtilidad.classList.add("hidden");
    btnUtilSi.disabled = false;
    btnUtilNo.disabled = false;
    ultimaEstimacionId = null;

    const mes = Number((form.elements.namedItem("mes") as HTMLSelectElement).value);
    const diametro = Number((form.elements.namedItem("diametro") as HTMLInputElement).value);

    if (![2, 12].includes(mes)) {
      mostrarAlerta("Seleccione febrero o diciembre.");
      return;
    }
    if (!Number.isFinite(diametro) || diametro <= 0) {
      mostrarAlerta("Ingrese un diámetro mayor a cero, en metros.");
      return;
    }

    const { data } = await supabase.auth.getSession();
    const token = data.session?.access_token;
    const usuarioId = data.session?.user?.id;

    if (!token || !usuarioId) {
      window.location.href = "/login";
      return;
    }

    cargando(true);
    try {
      const response = await fetch("/api/predict", {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ mes, diametro }),
      });

      if (response.status === 401) {
        window.location.href = "/login";
        return;
      }

      if (response.status === 422) {
        const cuerpo = await response.json().catch(() => null);
        mostrarAlerta(typeof cuerpo?.detail === "string" ? cuerpo.detail : "Los datos ingresados no son válidos.");
        await registrarEstimacion({
          usuario_id: usuarioId,
          mes,
          diametro,
          estado: "rechazada",
        });
        return;
      }

      if (!response.ok) {
        await registrarEstimacion({
          usuario_id: usuarioId,
          mes,
          diametro,
          estado: "error",
        });
        throw new Error("servicio no disponible");
      }

      const r = await response.json();
      if (!esNumero(r.q10) || !esNumero(r.mediana) || !esNumero(r.q90)) {
        throw new Error("respuesta inesperada");
      }

      const version = String(r.version_modelo ?? "");
      ultimaEstimacionId = await registrarEstimacion({
        usuario_id: usuarioId,
        mes,
        diametro,
        q10: r.q10,
        mediana: r.mediana,
        q90: r.q90,
        version_modelo: version,
        estado: "aceptada",
      });

      rellenar("q10", r.q10.toLocaleString("es-CL"));
      rellenar("mediana", r.mediana.toLocaleString("es-CL"));
      rellenar("q90", r.q90.toLocaleString("es-CL"));
      rellenar("version_modelo", version);

      if (ultimaEstimacionId) {
        bloqueUtilidad.classList.remove("hidden");
      }
      resultContainer.classList.remove("hidden");
    } catch {
      mostrarAlerta("El servicio de estimación no está disponible en este momento. Intente nuevamente más tarde.");
    } finally {
      cargando(false);
    }
  });
</script>