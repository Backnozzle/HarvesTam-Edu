---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";

const pilares = [
  {
    t: "Monitoreo real",
    d: "Hecho en base a un registro de 8 años de seguimiento biológico en terreno por parte del Felipe Carevic y su equipo de investigación, destacado Doctor en gestión ambiental chileno."
  },
  {
    t: "Metodología CRISP-DM",
    d: "Estructurado en un ciclo formal de minería de datos, desde la comprensión y depuración de registros históricos hasta el despliegue de un modelo en producción."
  },
  {
    t: "Impacto ambiental",
    d: "Transformamos mediciones de la especie en estimaciones de biomasa frutal para respaldar planes de trasplante, manejo y reforestación."
  }
];
---

<Layout>
<section id="proyecto" class="w-full bg-desierto text-arbol px-6 sm:px-12 md:px-16 py-20 sm:py-28 border-t border-trazo/40">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <div class="max-w-3xl space-y-4">
      
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal leading-tight">
        El proyecto HarvesTam · Edu
      </h2>

      <p class="text-base sm:text-lg text-arbol/85 leading-relaxed">
        Desarrollado como iniciativa de titulación en Ingeniería en Informática (Sede Duoc UC Melipilla), el sistema trata campos de la ciencia de datos, arquitectura y desarrollo de software para apoyar decisiones frente a la degradación del bosque nativo en el norte árido de Chile.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-12 pt-6">
      {pilares.map((p) => (
        <article class="border-t border-arbol/30 pt-6 space-y-3">
          <h3 class="font-serif text-xl sm:text-2xl font-medium text-arbol">
            {p.t}
          </h3>
          <p class="text-sm sm:text-base text-arbol/80 leading-relaxed font-sans">
            {p.d}
          </p>
        </article>
      ))}
    </div>

    <div class="bg-arbol/5 border border-trazo/60 p-6 sm:p-8 rounded-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-1">
        <h4 class="font-serif text-lg font-medium text-arbol">
          Compromiso con el Software Libre y la Reproducibilidad
        </h4>
        <p class="text-sm text-arbol/75 max-w-2xl font-sans">
          Toda la pila tecnológica se sustenta bajo herramientas abiertas: contenedores Docker, backend desacoplado con FastAPI y modelos serializados sin dependencias privativas.
        </p>
      </div>

      <div class="flex-shrink-0">
        <a
          href="/#especie"
          class="inline-flex items-center text-sm font-medium text-arbol border-b border-arbol pb-0.5 hover:opacity-75 transition-opacity"
        >
          Ver contexto de la especie
        </a>
      </div>
    </div>

  </div>
</section>
</Layout>